<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvUploadHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add material"
            android:textColor="@color/on_background"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFulfilInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPickedFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:text="No file picked yet"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPickFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Pick a file" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save into subject"
            android:textColor="@color/on_background"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerUploadSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:padding="8dp" />

        <EditText
            android:id="@+id/etUploadTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Title (this is what search finds)"
            android:padding="12dp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/etUploadNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Your note, e.g. Math homework — Unit 3"
            android:padding="12dp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/etUploadTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Tags, comma separated (unit 3, notes, exam)"
            android:padding="12dp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/muted" />

        <ProgressBar
            android:id="@+id/progressUpload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDoUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Save to INDEX" />
    </LinearLayout>
</ScrollView>
