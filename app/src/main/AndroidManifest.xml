<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet: needed once the Firebase backend is wired in (sync, cloud
         storage). Local mode itself never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app updates: the Profile screen downloads the new APK from
         GitHub Releases and hands it to the system installer. Android
         routes the user through its one-time "allow installs from this
         app" prompt — that prompt is expected behaviour, not a bug. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- No storage permissions on purpose: every file enters through the
         system picker (ACTION_OPEN_DOCUMENT / GetContent) or the share
         sheet, both of which grant access per-file with no prompt. -->

    <application
        android:name=".IndexApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Index">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shares can also land on the launcher activity. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The dedicated share target: INDEX appears in the Android share
             sheet for PDFs, images and documents from any app. -->
        <activity
            android:name=".ui.ShareReceiverActivity"
            android:exported="true"
            android:label="Save to INDEX"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The gate: Google sign-in, then the member check. MainActivity
             stays the launcher and routes everyone through these two. -->
        <activity
            android:name=".ui.auth.SignInActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.auth.JoinPendingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.members.MembersActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Retired from the flow: cloud bootstrap (owner's first sign-in)
             replaces the local first-run setup. The screen stays declared
             so nothing dangles; nothing launches it anymore. -->
        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.subject.SubjectDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.upload.UploadActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.trash.TrashActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.preview.PdfPreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.preview.ImageViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
